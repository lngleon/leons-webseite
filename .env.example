# Vorlage für .env.local – kopieren und Werte eintragen:
#   cp .env.example .env.local
# .env.local steht in .gitignore und wird NIE committet.
# Claude liest und schreibt .env* nicht (Deny-Regel in .claude/settings.json) –
# .env.local legt der User immer selbst an.

# Formspree-Endpoint des Kontaktformulars (Formspree → Form → Integration).
# Pflicht: ohne diesen Wert sendet das Kontaktformular nicht.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/DEINE-FORM-ID

# Optional: absolute Basis-URL der Seite – sitemap.xml/robots.txt schreiben
# dann die richtige URL statt der automatisch erkannten. In Vercel als
# Projekt-Env setzen (aktuelle Vercel-Domain, später die eigene Domain).
# NEXT_PUBLIC_SITE_URL=https://deine-domain.tld

# WICHTIG: Variablen mit NEXT_PUBLIC_-Präfix landen im Client-Bundle und sind
# öffentlich einsehbar. Hier NIEMALS eintragen: Secret-Keys oder Zugangsdaten –
# dieses Projekt braucht keine (reines Frontend, kein Backend).
